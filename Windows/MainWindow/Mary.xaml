<Window x:Class="Mary.Windows.MainWindow.Mary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mary.Windows.MainWindow"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Title="Mary" 
        Width="1000" Height="450"
        MinWidth="850" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="15,12,15,15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" 
                        TabStripPlacement="Top"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE8D6;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Libros" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,5,0,0">
                        <TextBlock Text="Lista de libros..." 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"/>
                    </Border>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE82D;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Canciones" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,5,0,0">
                        <TextBlock Text="Lista de música..." 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"/>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1" 
                    Height="48" 
                    Margin="0,8,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="VISUALIZADOR DE MUSICA" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="Medium"/>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="32" Margin="0,5,0,8">
                <TextBlock x:Name="TxtBookTitle" 
                           Text="Book Title" 
                           FontSize="15" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button x:Name="BtnSettings" Click="BtnSettings_Click"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Width="30" Height="30"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" 
                               Text="&#xE713;" 
                               FontSize="13" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        CornerRadius="8">
                    <TextBlock x:Name="TxtBookContent" 
                               Text="LECTOR DEL LIBRO" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Opacity="0.7"/>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>