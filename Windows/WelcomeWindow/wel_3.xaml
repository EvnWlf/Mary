<Page x:Class="Mary.Windows.WelcomeWindow.wel_3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mary.Windows.WelcomeWindow"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="wel_3"
      Opacity="0">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="Run">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="55,30,55,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mary" 
                   Grid.Row="0"
                   FontWeight="Bold" 
                   FontSize="28" 
                   HorizontalAlignment="Right"/>

        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,35,0">
                <TextBlock FontSize="22" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" 
                           LineHeight="32">
                    <Run Text="Ahora selecciona la ruta donde est"/><Run Language="es-mx" Text="an tus libros"/>
                </TextBlock>

                <TextBlock Text="Escanearemos tu biblioteca para organizar tus libros automáticamente." 
                           FontSize="13" 
                           Opacity="0.7" 
                           TextWrapping="Wrap" 
                           Margin="0,15,0,0"
                           LineHeight="20"/>
            </StackPanel>

            <TreeView x:Name="BooksFolder" 
                      Grid.Column="1" 
                      Height="240"
                      Margin="10,0,0,0"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">

                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                        <EventSetter Event="Collapsed" Handler="TreeViewItem_Collapsed"/>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <Button x:Name="BtnNext" 
                Grid.Row="2"
                Content="Siguiente" 
                Style="{DynamicResource AccentButtonStyle}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Cursor="Hand"
                Click="BtnNext_Click" />
    </Grid>
</Page>