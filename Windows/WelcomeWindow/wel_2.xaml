<Page x:Class="Mary.Windows.WelcomeWindow.wel_2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="wel_2"
      Opacity="0">

    <Grid Margin="55,30,55,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Mary" 
                   Grid.Row="0"
                   FontFamily="Georgia" 
                   FontWeight="Bold" 
                   FontSize="28" 
                   HorizontalAlignment="Right"/>


        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,35,0">
                <TextBlock Text="Ahora selecciona la ruta donde está tu música" 
                           FontFamily="Georgia" 
                           FontSize="22" 
                           TextWrapping="Wrap" 
                           LineHeight="32"/>

                <TextBlock Text="Escanearemos tu biblioteca para organizar tus canciones, listas y álbumes automáticamente." 
                           FontFamily="Georgia" 
                           FontSize="13" 
                           Opacity="0.7" 
                           TextWrapping="Wrap" 
                           Margin="0,15,0,0"
                           LineHeight="20"/>
            </StackPanel>
            <TreeView x:Name="TvMusicFolder" 
                      Grid.Column="1" 
                      Height="240"
                      Margin="10,0,0,0">

                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <Button x:Name="BtnNext" 
                Grid.Row="2"
                Content="Siguiente &gt;" 
                FontFamily="Georgia" 
                FontSize="20" 
                FontWeight="Bold"
                BorderThickness="0"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Cursor="Hand"
                Click="BtnNext_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>