<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <Title>Mary</Title>
    <Copyright>Evnwlf 2026</Copyright>
    <PackageProjectUrl>https://github.com/EvnWlf/Mary</PackageProjectUrl>
    <PackageIcon>Frame 1 (1).png</PackageIcon>
    <RepositoryUrl>https://github.com/EvnWlf/Mary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>es-MX</NeutralLanguage>
    <Authors>Evan Robles</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\app_icon.ico" />
    <None Remove="Assets\app_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Lists\Books\" />
    <Folder Include="Lists\Songs\" />
    <Folder Include="Modules\Service\" />
    <Folder Include="Modules\Settings\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Downloads\Frame 1 (1).png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
